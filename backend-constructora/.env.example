# Copia este archivo como ".env" (local) o cárgalo en la "Configuración" de App Service (Azure).
# NO pongas valores reales en este archivo de ejemplo.

PORT=4000
NODE_ENV=production

# --- Base de datos PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# En Azure PostgreSQL es obligatorio:
DB_SSL=true

# --- Seguridad ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL(s) del frontend, separadas por coma. Ejemplo: https://mi-frontend.azurestaticapps.net
CORS_ORIGIN=

# --- Almacenamiento de documentos ---
# Sin estas variables los archivos se guardan en disco (solo para desarrollo).
# Con una de las dos opciones se usa Azure Blob Storage (contenedores privados "expedientes" e "inventario"):
AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_URL=https://<cuenta>.blob.core.windows.net   # alternativa con identidad administrada (requiere @azure/identity)
